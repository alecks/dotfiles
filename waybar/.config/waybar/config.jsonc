{
  "height": 42,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"
  ],
  "modules-center": [
    "mpris",
    "hyprland/window"
  ],
  "modules-right": [
    "group/hardware",
    "group/system",
    "group/info"
  ],
  "custom/sep": {
    "format": "|",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": false,
    "all-outputs": false,
    "show-special": true
  },
  "hyprland/submap": {
    "format": "{}",
    "tooltip": false
  },
  "mpris": {
    "format": "{status_icon}  {dynamic}",
    "format-paused": "󰏤  {dynamic}",
    "format-playing": "󰝚  {dynamic}",
    "format-stopped": "",
    "dynamic-order": ["artist", "title"],
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": false,
    "rewrite": {
      "^$": "pleemcentre"
    }
  },
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "custom/sep",
      "memory",
      "custom/sep",
      "temperature"
    ]
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "tooltip": true
  },
  "memory": {
    "format": "󰍛 {}%"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "󰔏 {temperatureC}°C"
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "wireplumber",
      "custom/sep",
      "power-profiles-daemon",
      "custom/sep",
      "idle_inhibitor"
    ]
  },
  "group/info": {
    "orientation": "horizontal",
    "modules": [
      "clock",
      "custom/sep",
      "tray",
      "custom/sep",
      "custom/power"
    ]
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "pavucontrol"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    },
    "tooltip-format": "Power profile: {profile}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛨",
      "deactivated": "󰒲"
    },
    "tooltip-format-activated": "Caffeine: on",
    "tooltip-format-deactivated": "Caffeine: off"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "on-click-right": "gnome-calendar"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
      "logout": "swaymsg exit",
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  }
}
