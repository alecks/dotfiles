{
  "height": 34,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap",
    "mpris"
  ],
  "modules-center": [
    "group/datetime"
  ],
  "modules-right": [
    "group/controls"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "disable-scroll": false,
    "all-outputs": false,
    "show-special": true
  },
  "hyprland/submap": {
    "format": "{}",
    "tooltip": false
  },
  "mpris": {
    "format": "{status_icon}  {dynamic}",
    "format-paused": "󰏤  {dynamic}",
    "format-playing": "󰝚   {dynamic}",
    "format-stopped": "",
    "dynamic-order": [
      "artist",
      "title"
    ],
    "max-length": 36,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "custom/hardware",
      "cpu",
      "memory",
      "temperature",
      "power-profiles-daemon",
      "idle_inhibitor"
    ],
    "drawer": {
      "transition-duration": 180,
      "children-class": "hardware-reading",
      "transition-left-to-right": false
    }
  },
  "cpu": {
    "format": "cpu {usage}%",
    "tooltip": true
  },
  "memory": {
    "format": "mem {}%"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C"
  },
  "wireplumber": {
    "format": "vol <span font_family=\"Berkeley Mono\">{volume}%</span>",
    "format-muted": "muted",
    "on-click": "pavucontrol"
  },
  "power-profiles-daemon": {
    "format": "{profile}",
    "tooltip-format": "Power profile: {profile}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "awake",
      "deactivated": "auto"
    },
    "tooltip-format-activated": "Sleep inhibited · click to allow sleep",
    "tooltip-format-deactivated": "Automatic sleep · click to keep awake"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "on-click-right": "gnome-calendar"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
      "logout": "uwsm stop",
      "shutdown": "systemctl poweroff",
      "reboot": "systemctl reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  },
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "fixed-center": true,
  "custom/hardware": {
    "format": "system",
    "tooltip": false
  },
  "custom/tray": {
    "format": "apps",
    "tooltip": false
  },
  "group/tray-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 180,
      "children-class": "tray-reveal",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/tray",
      "tray"
    ]
  },
  "group/datetime": {
    "orientation": "horizontal",
    "modules": [
      "custom/date",
      "clock"
    ]
  },
  "custom/date": {
    "exec": "python3 \"$HOME/.config/waybar/scripts/date.py\"",
    "interval": 60,
    "tooltip": false
  },
  "group/controls": {
    "orientation": "horizontal",
    "modules": [
      "wireplumber",
      "group/hardware",
      "group/tray-drawer",
      "custom/power"
    ]
  }
}
