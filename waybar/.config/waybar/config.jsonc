    "group/info"
  ],

  "custom/left": {
    "format": "[",
    "tooltip": false
  },
  "custom/right": {
    "format": "]",
    "tooltip": false
  },
  "custom/sep": {
    "format": "|",
    "tooltip": false
  },

  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/left",
      "sway/workspaces",
      "custom/right"
    ]
  },

  "sway/workspaces": {
    "format": "{name}",
    "disable-scroll": false,
    "all-outputs": false
  },

  "sway/mode": {
    "format": "[ {} ]"
  },

