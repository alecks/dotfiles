margin=8
padding=12
border-size=1
border-radius=6
width=360
height=160
max-icon-size=32

background-color=#1f1f26
text-color=#c5c9c7
border-color=#8ba4b0
progress-color=over #393b44

font=IBM Plex Sans 11
format=<span font_desc="Berkeley Mono 9" foreground="#a4a7a4">%a</span>\n<b>%s</b>\n%b

on-button-left=exec makoctl menu -n "$id" -- tofi --prompt-text='action › '
on-button-right=dismiss

default-timeout=10000
ignore-timeout=1

[urgency=low]
background-color=#1f1f26
text-color=#c5c9c7
border-color=#393b44

[urgency=normal]
background-color=#1f1f26
text-color=#c5c9c7
border-color=#8ba4b0

[urgency=critical]
background-color=#1f1f26
text-color=#c4746e
border-color=#c4746e

# Ghostty and other clients may omit the app name; avoid an empty label row.
[app-name=""]
format=<b>%s</b>\n%b
